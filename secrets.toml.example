# ============================================================
#  Secrets（秘密設定）の記入例
#  ※このファイルは「見本」です。実際の値は Git に載せないでください。
#
#  【ネット公開する場合】
#   アプリ管理画面 → Settings → Secrets に、下の中身を貼り付けて編集します。
#
#  【事務所PCのローカルで試す場合】
#   このファイルを  .streamlit/secrets.toml  という名前でコピーして値を書き換えます。
#   （.streamlit フォルダが無ければ作成。secrets.toml は Git に載りません）
# ============================================================

# --- 不動産情報ライブラリのAPIキー（全員で共有。各自取得は不要） ---
REINFOLIB_API_KEY = "ここに国交省APIキーを貼る"

# --- 案件の保存・読込を公開版でも許可するか（既定は無効を推奨） ---
# 依頼者情報を外部サーバに置くことになるため、通常は false のままにしてください。
allow_case_save = false

# --- 入れる人ごとの「合言葉」（表示名 = 合言葉）。1人1行。 ---
# ・ここに書いた合言葉を、その人だけに伝えます。
# ・辞めた人・共有をやめたい人は、その行を消せば即座に入れなくなります。
# ・合言葉は長め（例：単語を4つ以上つなげる）にすると安全です。
[access]
"岩井（管理者）" = "ここを長い合言葉に変える-1"
"スタッフ田中"   = "ここを長い合言葉に変える-2"
"友人の佐藤"     = "ここを長い合言葉に変える-3"
